{
  "name": "expenses-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "rm -rf .turbo $(find . -type d -name \".turbo\")",
    "init": "pnpm i",
    "clean:all": "rm -rf ./.turbo/cache $(find . -type d -name \"node_modules\") $(find . -type d -name \"dist\") $(find . -type d -name \".next\")",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
